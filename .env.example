# API
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=https://your-domain.example
TRUST_PROXY_HOPS=0
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=1h
DB_CONNECTION_LIMIT=10

# MySQL 8 database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shedshare
DB_USER=shedshare_app
DB_PASSWORD=replace_with_a_local_password

# Supabase project: configure Auth email confirmations and create the public
# Storage bucket named below. The service role key stays server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=shedshare-media
MAX_IMAGE_BYTES=8388608
MAX_VIDEO_BYTES=20971520
MAX_VIDEO_DURATION_SECONDS=60
EMAIL_VERIFICATION_REDIRECT_URL=https://your-domain.example/index.html

# Google OAuth Web Client ID; configure matching authorized origins in Google Cloud.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Paystack secret key. Register https://your-api.example/api/payments/paystack/webhook
# in the Paystack dashboard. Never add the secret key to frontend files.
PAYSTACK_SECRET_KEY=sk_test_replace_me
