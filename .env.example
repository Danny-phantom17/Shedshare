# API
NODE_ENV=development
AUTH_MODE=supabase
PORT=3000
ALLOWED_ORIGINS=https://your-domain.example
TRUST_PROXY_HOPS=0
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=1h
CHECKOUT_RESERVATION_MINUTES=30
# Optional real email provider adapter; without these only in-app notifications are sent.
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_API_KEY=
# Optional standards-based Web Push keys. Generate a persistent pair with `npm run setup:web-push`.
# Copy both values into the hosting provider's server environment for production phone alerts.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
DB_CONNECTION_LIMIT=10
DELIVERY_CONFIRMATION_WINDOW_HOURS=24
# ShedShare Live dispatch and tracking controls (bounds/fallbacks are in delivery-config.js)
RIDER_SEARCH_RADIUS_KM=10
RIDER_OFFER_TIMEOUT_MINUTES=10
RIDER_JOB_OFFER_MINUTES=2
RIDER_CANCEL_WARNING_THRESHOLD=3
RIDER_CANCEL_REVIEW_THRESHOLD=5
RIDER_LOW_RATING_THRESHOLD=3.5
RIDER_LOW_RATING_MINIMUM_COUNT=3
RIDER_PRIVATE_STORAGE_BUCKET=shedshare-rider-private
DELIVERY_LOCATION_INTERVAL_SECONDS=15
DELIVERY_LOCATION_MIN_MOVEMENT_METERS=20
DELIVERY_LOCATION_STALE_SECONDS=90
DELIVERY_MAX_TRACKING_HOURS=6
DELIVERY_MAX_SPEED_MPS=55
DELIVERY_LOCATION_RATE_LIMIT_PER_MINUTE=6
DELIVERY_TRACKING_POLL_SECONDS=10

# In-app chat controls
CHAT_MESSAGES_PER_MINUTE=30
CHAT_RETENTION_MONTHS=12
CHAT_COMPLETION_LOCK_DAYS=7
CHAT_MAX_IMAGE_BYTES=5242880
CHAT_STREAM_POLL_MS=5000
CHAT_NOTIFICATION_BATCH_MINUTES=5
CHAT_PRIVATE_STORAGE_BUCKET=shedshare-chat-private

# Emergency server-side kill switch. Actual AI remains off until the site admin enables it in the admin dashboard.
AI_FEATURES_ENABLED=true
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite

# Cloudinary listing-photo cleaning is opt-in. Configure these server-only
# credentials, review your Cloudinary plan/credit usage, then explicitly enable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PHOTO_ENHANCEMENT_ENABLED=false

# MySQL 8 database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shedshare
DB_USER=shedshare_app
DB_PASSWORD=replace_with_a_local_password
DB_BACKUP_DIR=./backups
DB_RESTORE_TEST_NAME=shedshare_restore_test
MYSQLDUMP_BIN=mysqldump
MYSQL_BIN=mysql
SECURITY_ALERT_EMAIL=admin@example.com

# Supabase project for Auth and Storage. The relational app database is MySQL
# (not Supabase Postgres). Configure Auth email confirmations and create the
# public Storage bucket named below. Keep the secret key server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key
SUPABASE_SECRET_KEY=replace_with_supabase_secret_key
SUPABASE_STORAGE_BUCKET=shedshare-media
# Storage cleanup is administrator-triggered and dry-run by default. Keep deletion disabled
# until reviewed reports, backups, retention policy, and provider settings have been approved.
STORAGE_CLEANUP_RETENTION_DAYS=30
STORAGE_CLEANUP_DELETE_ENABLED=false
# Request reference images contain renter-provided details; this bucket must be private.
REQUEST_PRIVATE_STORAGE_BUCKET=shedshare-request-references-private
MAX_IMAGE_BYTES=8388608
MAX_VIDEO_BYTES=20971520
MAX_VIDEO_DURATION_SECONDS=60
EMAIL_VERIFICATION_REDIRECT_URL=https://your-domain.example/index.html

# Google OAuth Web Client ID; configure matching authorized origins in Google Cloud.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Geoapify map tiles for Explore and delivery maps. Restrict the browser key to
# your site origins. The listing form itself uses device location without a map.
GEOAPIFY_MAPS_BROWSER_KEY=
GEOAPIFY_API_KEY=
# Optional Google Geocoding API key for higher-precision pickup address lookup.
# Keep this server-side and restrict it to the Geocoding API. When set, it is
# preferred over GEOAPIFY_API_KEY for address lookup; GPS still comes from the device.
GOOGLE_MAPS_SERVER_KEY=
# Optional external business search. Disabled until deliberately enabled.
EXTERNAL_SEARCH_ENABLED=false
MIN_LISTINGS_FOR_EXTERNAL=100
EXTERNAL_SEARCH_MAX_PER_USER_PER_DAY=5
EXTERNAL_SEARCH_BIAS_RADIUS_METERS=5000
# Separate server-only key restricted to Places API (New), Text Search only.
GOOGLE_MAPS_PLACES_SERVER_KEY=
# Payment mode defaults to manual. Paystack initialization is server-gated and
# requires PAYMENT_MODE=paystack plus an environment-appropriate secret.
PAYMENT_MODE=manual
# Paystack secret key. Use an sk_test_ key only in development and sk_live_ in
# production. Register the webhook URL in Paystack. Never expose this key.
# Never add the secret key to frontend files.
PAYSTACK_SECRET_KEY=sk_test_replace_me
