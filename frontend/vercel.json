{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/config.js", "destination": "/api/frontend-config" }
  ],
  "headers": [
    { "source": "/service-worker.js", "headers": [ { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }, { "key": "Service-Worker-Allowed", "value": "/" } ] },
    { "source": "/config.js", "headers": [ { "key": "Cache-Control", "value": "no-store" } ] }
  ]
}
